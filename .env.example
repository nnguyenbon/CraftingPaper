# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# ==============================================================================
# CẤU HÌNH GỬI MAIL THÀNH PHẨM QUA GOOGLE MAIL (GMAIL)
# ==============================================================================
# 1. GMAIL_USER: Địa chỉ Gmail của bạn dùng để gửi email tới người dùng.
#    Ví dụ: myworkshop@gmail.com
GMAIL_USER="your_email@gmail.com"

# 2. GMAIL_APP_PASSWORD: Mật khẩu ứng dụng 16 ký tự của Google (KHÔNG phải mật khẩu đăng nhập bình thường).
#    Cách lấy cực nhanh trong 1 phút:
#    a. Truy cập: https://myaccount.google.com/security
#    b. Bật "Xác minh 2 bước" (2-Step Verification) nếu chưa bật.
#    c. Vào mục "Mật khẩu ứng dụng" (App passwords) -> Đặt tên ứng dụng (VD: CraftingPaper).
#    d. Google sẽ cấp cho bạn 1 mã 16 ký tự (ví dụ: abcd efgh ijkl mnop).
#    e. Dán mã 16 ký tự đó vào bên dưới (có hoặc không có dấu cách đều được hệ thống tự xử lý).
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"

# 3. (Tùy chọn) Tên hiển thị người gửi khi khách nhận email
GMAIL_SENDER_NAME="Tiệm Giấy Thủ Công CraftingPaper"
